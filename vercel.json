{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/about", "destination": "/pages/about" },
    { "source": "/contact", "destination": "/pages/contact" },
    { "source": "/works", "destination": "/pages/works" },
    { "source": "/testimonials", "destination": "/pages/testimonials" },
    { "source": "/privacy-policy", "destination": "/pages/privacy-policy" },
    { "source": "/404", "destination": "/pages/404" },
    { "source": "/styles.css", "destination": "/css/styles.css" },
    { "source": "/site-renderer.js", "destination": "/js/site-renderer.js" },
    { "source": "/main.js", "destination": "/js/main.js" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
