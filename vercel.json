
{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/pages/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pages/about.html",
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/pages/works.html",
      "destination": "/works",
      "permanent": false
    },
    {
      "source": "/pages/contact.html",
      "destination": "/contact",
      "permanent": false
    },
    {
      "source": "/pages/testimonials.html",
      "destination": "/testimonials",
      "permanent": false
    },
    {
      "source": "/pages/privacy-policy.html",
      "destination": "/privacy-policy",
      "permanent": false
    },
    {
      "source": "/pages/404.html",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/pages/404",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/((?!api/|assets/|css/|js/|config/|about(?=$|/|\\.html)|works(?=$|/|\\.html)|contact(?=$|/|\\.html)|testimonials(?=$|/|\\.html)|privacy-policy(?=$|/|\\.html)|404(?=$|/|\\.html)|index(?=$|/|\\.html)|styles\\.css|site-renderer\\.js|main\\.js|favicon|robots\\.txt|sitemap\\.xml|$).+)",
      "destination": "/404",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/pages/about.html"
    },
    {
      "source": "/contact",
      "destination": "/pages/contact.html"
    },
    {
      "source": "/works",
      "destination": "/pages/works.html"
    },
    {
      "source": "/testimonials",
      "destination": "/pages/testimonials.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/pages/privacy-policy.html"
    },
    {
      "source": "/404",
      "destination": "/404.html"
    },
    {
      "source": "/styles.css",
      "destination": "/css/styles.css"
    },
    {
      "source": "/site-renderer.js",
      "destination": "/js/site-renderer.js"
    },
    {
      "source": "/main.js",
      "destination": "/js/main.js"
    },
    {
      "source": "/((?!api/|assets/|css/|js/|config/).*)",
      "destination": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
