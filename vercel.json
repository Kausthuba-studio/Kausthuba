{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/pages/index.html" },
    { "source": "/about", "destination": "/pages/about.html" },
    { "source": "/about.html", "destination": "/pages/about.html" },
    { "source": "/contact", "destination": "/pages/contact.html" },
    { "source": "/contact.html", "destination": "/pages/contact.html" },
    { "source": "/works", "destination": "/pages/works.html" },
    { "source": "/works.html", "destination": "/pages/works.html" },
    { "source": "/testimonials", "destination": "/pages/testimonials.html" },
    { "source": "/testimonials.html", "destination": "/pages/testimonials.html" },
    { "source": "/privacy-policy", "destination": "/pages/privacy-policy.html" },
    { "source": "/privacy-policy.html", "destination": "/pages/privacy-policy.html" },
    { "source": "/404", "destination": "/pages/404.html" },
    { "source": "/404.html", "destination": "/pages/404.html" },
    { "source": "/styles.css", "destination": "/css/styles.css" },
    { "source": "/site-renderer.js", "destination": "/js/site-renderer.js" },
    { "source": "/main.js", "destination": "/js/main.js" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
